{
    "preset": "laravel",
    "rules": {
        "php_unit_method_casing": {
            "case": "camel_case"
        },
        "new_with_parentheses": {
            "named_class": true,
            "anonymous_class": false
        },
        "concat_space": {
            "spacing": "one"
        }
    }
}
